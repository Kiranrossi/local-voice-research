{"id": "en_01", "text": "Transfer ₹2,499 to Karthikeyan on 15th August.", "audio_filepath": "/content/drive/MyDrive/local-voice-research/tts/qwen3-tts-0-6b__nvidia_gpu/en_01.wav", "duration": 5.92, "gen_s": 14.6431, "sample_rate": 24000, "error": ""}
