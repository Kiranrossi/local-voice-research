{"id": "g03", "text": "The weather today is mostly sunny, with a light breeze in the afternoon.", "audio_filepath": "/content/drive/MyDrive/local-voice-research/tts/qwen3-tts-0-6b__nvidia_gpu/g03.wav", "duration": 5.68, "gen_s": 13.6741, "sample_rate": 24000, "error": ""}
