{"id": "g01", "text": "Your order has been placed and will arrive by Friday evening.", "audio_filepath": "/content/drive/MyDrive/local-voice-research/tts/qwen3-tts-0-6b__nvidia_gpu/g01.wav", "duration": 5.44, "gen_s": 13.3189, "sample_rate": 24000, "error": ""}
